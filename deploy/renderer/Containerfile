# The renderer image (P3-75; design §15.1, D-416). Built from the repo root by deploy/build.sh (deploy compose takes it
# as RENDERER_IMAGE; the dev stack builds it itself), the root .dockerignore keeping the context small, on the stack's
# own pinned Python base (deploy/profiles/*/apps-versions.json
# base.python), with Pillow and pypdfium2 pinned by hash (requirements.txt). The readers are copied from the app at
# build time, never mounted: the container sees no site, no host path and no source tree. Nothing else is installed.
FROM python:3.14.8-slim-trixie@sha256:a2b82f3c48559aa0a8446d9af49826b6e2b2016f4cd2afabfe6013ec53729170

ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 PIP_NO_CACHE_DIR=1 PIP_DISABLE_PIP_VERSION_CHECK=1

COPY deploy/renderer/requirements.txt /tmp/requirements.txt
RUN python -m pip install --no-deps --require-hashes --only-binary=:all: -r /tmp/requirements.txt \
    && rm /tmp/requirements.txt \
    && python -m pip uninstall -y pip \
    && useradd --system --uid 10001 --user-group --no-create-home --shell /usr/sbin/nologin renderer \
    && mkdir -p /run/renderer && chown 10001:10001 /run/renderer

COPY deploy/renderer/server.py deploy/renderer/child.py /opt/renderer/
COPY apps/construction_core/construction_core/previews/readers/ /opt/renderer/construction_core/previews/readers/
COPY apps/construction_core/construction_core/takeoff/dxf.py /opt/renderer/construction_core/takeoff/dxf.py
# Empty package files: the app's own would import frappe, which this image does not have.
RUN touch /opt/renderer/construction_core/__init__.py /opt/renderer/construction_core/previews/__init__.py \
        /opt/renderer/construction_core/takeoff/__init__.py \
    && python -m compileall -q /opt/renderer \
    && chmod -R a-w /opt/renderer

USER 10001:10001
CMD ["python", "-I", "/opt/renderer/server.py"]
